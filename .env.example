# Kopieren nach .env und ausfüllen. Die echte .env nie committen (steht in .gitignore).

# Auth-Key für den Tailscale-Sidecar (ts-fitness in docker-compose.yml).
# Erzeugen unter https://login.tailscale.com/admin/settings/keys —
# am besten "Reusable" aus und mit dem Tag tag:pwa-sidecar, den die
# Tailnet-ACL als tagOwner kennen muss (siehe README, "Selbst hosten").
# Nach dem ersten Start merkt sich der Container seinen Zustand im Volume
# ts-fitness-state; der Key wird danach nicht mehr gebraucht.
TS_AUTHKEY=
